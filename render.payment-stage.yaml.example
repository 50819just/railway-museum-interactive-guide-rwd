# STAGE configuration only. Not applied/deployed. External free Neon DB + migration required.
# No paid service/disk, no automatic seed/migration; obtain approval before public deployment.
services:
  - type: web
    name: railway-museum-payment-stage
    runtime: node
    plan: free
    autoDeployTrigger: "off"
    buildCommand: npm ci --omit=dev --ignore-scripts --prefix server/payment
    startCommand: node server/payment/pg-main.mjs --listen
    healthCheckPath: /api/health
    envVars:
      - key: NODE_VERSION
        value: 24.14.1
      - key: PAYMENT_MODE
        value: stage
      - key: PAYMENT_DEPLOYMENT
        value: render-free-stage
      - key: PAYMENT_DATABASE
        value: postgres
      - key: DATABASE_URL
        sync: false
      - key: PAYMENT_ALLOWED_ORIGIN
        sync: false
      - key: PAYMENT_CLIENT_BACK_URL
        sync: false
      - key: PAYMENT_OPENS_AT
        sync: false
      - key: PAYMENT_CLOSES_AT
        sync: false
      - key: PAYMENT_HOLD_MINUTES
        value: 15
      - key: ECPAY_MERCHANT_ID
        sync: false
      - key: ECPAY_HASH_KEY
        sync: false
      - key: ECPAY_HASH_IV
        sync: false
# No automatic seed, no staff key in public service, no source-controlled secrets.
