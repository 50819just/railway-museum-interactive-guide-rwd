# Server only. Do not use VITE_* for merchant credentials or tester/staff tokens.
PAYMENT_MODE=stage
# Choose an unused port yourself; this service never falls back to another port.
PAYMENT_PORT=
PAYMENT_DB_PATH=
PAYMENT_ALLOWED_ORIGIN=http://localhost:5179
PAYMENT_CLIENT_BACK_URL=http://localhost:5179/#train
# Required sandbox policy; demo duration is NOT an approved museum policy.
PAYMENT_HOLD_MINUTES=15
PAYMENT_OPENS_AT=
PAYMENT_CLOSES_AT=
# Copy the AIO STAGE test values from https://developers.ecpay.com.tw/2856/
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
# Public HTTPS, no explicit port; leave empty to block checkout until provisioned.
ECPAY_RETURN_URL=
# Generate distinct random 32+ character values; never put these in VITE_* or Git.
PAYMENT_FIXTURE_TOKEN=
PAYMENT_STAFF_TOKEN=

# Default local. For the chosen FREE Render service use render-free-stage + postgres.
PAYMENT_DEPLOYMENT=local
# Free Render must not use a local SQLite file. DATABASE_URL points to dedicated Neon STAGE.
# Render injects RENDER, RENDER_EXTERNAL_URL, PORT. Callback is derived, not guessed.

# PostgreSQL optional locally, REQUIRED for render-free-stage. Keep credentials server-only.
PAYMENT_DATABASE=sqlite
DATABASE_URL=
# For free cloud: PAYMENT_DEPLOYMENT=render-free-stage, PAYMENT_DATABASE=postgres.
# Use a dedicated Neon Free STAGE database; SSL certificate verification stays enabled.

# Separate STAGE photo orders require the additive --migrate-prints action first.
PAYMENT_PRINTS_ENABLED=false
